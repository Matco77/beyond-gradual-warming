# --- OS / editor cruft ---
.DS_Store
*.tmp
.Rhistory
.Rproj.user/
__pycache__/

# --- Claude Code / agent tooling (not thesis content) ---
.agents/
.claude/
skills-lock.json
Econometrictookit pipeline/

# --- Large raw climate datasets (~58 GB) — NOT for GitHub ---
# Ignore everything directly under Amoc/datasets/ (all the raw-data SUBDIRECTORIES:
# CMIP6_piControl, anomaly_output, NAHosMIP, EOBS, GISCO_population_grid, Isimip,
# shapefiles, ...), then re-include only the small/medium PREPARED files that live
# loose in that folder (the numbered pipeline outputs + source CSVs, all < 100 MB).
Amoc/datasets/*
!Amoc/datasets/*.csv
!Amoc/datasets/*.gpkg
!Amoc/datasets/*.rds
!Amoc/datasets/*.py

# Safety net: never commit heavy binary grids even if they appear elsewhere
*.nc
*.nc4
*.grib
*.grb
*.tif
*.tiff
*.zip
*.tar
*.tar.gz
*.tgz
*.h5
*.hdf5
Amoc/isimip_download.log

# Regenerable scenario replays. Amoc/datasets/*.csv is re-included above, but that
# pattern does NOT match .csv.gz - these stay out on purpose (the crop table is
# ~4.2 M rows, past GitHub's file limit). Rebuild with scenario_replay_bins.R /
# scenario_replay_isimip_bins.R; see README.
Amoc/datasets/*.csv.gz

# Download cruft left in the repo root by wget / the ESGF and ISIMIP pulls.
# *.tar above already covers the 2.6 GB of CMIP6 tarballs that land here.
wget-log*
.wget_script_*.status
