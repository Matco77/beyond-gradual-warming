monthly_summary_nc <- function(file, varname, first_year) {
  
  nc <- nc_open(file)
  
  lon <- ncvar_get(nc, "lon")
  lat <- ncvar_get(nc, "lat")
  ntime <- nc$dim$time$len
  
  out <- vector("list", ntime)
  
  for (i in seq_len(ntime)) {
    
    arr <- ncvar_get(
      nc,
      varname,
      start = c(1, 1, i),
      count = c(length(lon), length(lat), 1)
    )
    
    file_year <- first_year + floor((i - 1) / 12)
    month <- ((i - 1) %% 12) + 1
    
    vals <- as.vector(arr)
    
    out[[i]] <- data.frame(
      file = basename(file),
      layer = i,
      file_year = file_year,
      experiment_year = file_year - 2050 + 1,
      month = month,
      mean_K = mean(vals, na.rm = TRUE),
      mean_C = mean(vals, na.rm = TRUE) - 273.15,
      min_K = min(vals, na.rm = TRUE),
      max_K = max(vals, na.rm = TRUE),
      p05_K = quantile(vals, 0.05, na.rm = TRUE),
      p50_K = quantile(vals, 0.50, na.rm = TRUE),
      p95_K = quantile(vals, 0.95, na.rm = TRUE)
    )
  }
  
  nc_close(nc)
  bind_rows(out)
}

