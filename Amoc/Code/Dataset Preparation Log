#tg daily mean temperature
#tn daily minimum temperature
#tx daily maximum temperature
#rr daily precipitation

# NetCDF files
tg_file <- file.path(eobs_dir, "tg_ens_mean_0.25deg_reg_v31.0e.nc")
tn_file <- file.path(eobs_dir, "tn_ens_mean_0.25deg_reg_v31.0e.nc")
tx_file <- file.path(eobs_dir, "tx_ens_mean_0.25deg_reg_v31.0e.nc")
rr_file <- file.path(eobs_dir, "rr_ens_mean_0.25deg_reg_v31.0e.nc")

# a) open files
nc_tg <- nc_open(tg_file)
nc_tn <- nc_open(tn_file)
nc_tx <- nc_open(tx_file)
nc_rr <- nc_open(rr_file)

lon <- ncvar_get(nc_tg, "longitude")
lat <- ncvar_get(nc_tg, "latitude")
time <- ncvar_get(nc_tg, "time")

ref_date <- as.Date(strsplit(nc_tg$dim$time$units, "since ")[[1]][2])
dates <- ref_date + time

nlon <- length(lon)
nlat <- length(lat)
ntime <- length(time)


# b) build grid map to assign each grid cell to a country
shp_file <- list.files(
  countries_dir,
  pattern = "\\.shp$",
  full.names = TRUE
)
countries <- st_read(shp_file, quiet = TRUE)

countries_europe <- countries %>%
  filter(CONTINENT == "Europe") %>%
  select(Country = ADMIN, geometry)

grid_cells <- expand_grid(lon = lon, lat = lat)

grid_points <- st_as_sf(
  grid_cells,
  coords = c("lon", "lat"),
  crs = 4326,
  remove = FALSE
)

grid_map <- st_join(
  grid_points,
  countries_europe,
  join = st_within,
  left = FALSE
) %>%
  st_drop_geometry() %>%
  mutate(
    ix = match(lon, lon),
    iy = match(lat, lat),
    cell_id = ix + (iy - 1) * nlon
  ) %>%
  select(Country, lon, lat, cell_id)

# Fix grid cell IDs
grid_map <- grid_map %>%
  mutate(
    ix = match(lon, lon),
    iy = match(lat, lat),
    cell_id = ix + (iy - 1) * length(lon)
  )

cell_id <- grid_map$cell_id
country <- grid_map$Country

if (file.exists(out_file)) file.remove(out_file)

chunk_days <- 7

for (t_start in seq(1, ntime, by = chunk_days)) {
  
  t_count <- min(chunk_days, ntime - t_start + 1)
  date_chunk <- dates[t_start:(t_start + t_count - 1)]
  
  tg_arr <- ncvar_get(nc_tg, "tg",
                      start = c(1, 1, t_start),
                      count = c(nlon, nlat, t_count),
                      collapse_degen = FALSE)
  
  tn_arr <- ncvar_get(nc_tn, "tn",
                      start = c(1, 1, t_start),
                      count = c(nlon, nlat, t_count),
                      collapse_degen = FALSE)
  
  tx_arr <- ncvar_get(nc_tx, "tx",
                      start = c(1, 1, t_start),
                      count = c(nlon, nlat, t_count),
                      collapse_degen = FALSE)
  
  rr_arr <- ncvar_get(nc_rr, "rr",
                      start = c(1, 1, t_start),
                      count = c(nlon, nlat, t_count),
                      collapse_degen = FALSE)
  
  dim(tg_arr) <- c(nlon * nlat, t_count)
  dim(tn_arr) <- c(nlon * nlat, t_count)
  dim(tx_arr) <- c(nlon * nlat, t_count)
  dim(rr_arr) <- c(nlon * nlat, t_count)
  
  dt <- data.table(
    Country = rep(country, times = t_count),
    date = rep(date_chunk, each = length(cell_id)),
    tg = as.vector(tg_arr[cell_id, , drop = FALSE]),
    tn = as.vector(tn_arr[cell_id, , drop = FALSE]),
    tx = as.vector(tx_arr[cell_id, , drop = FALSE]),
    rr = as.vector(rr_arr[cell_id, , drop = FALSE])
  )
  
  chunk_out <- dt[
    ,
    .(
      tg = mean(tg, na.rm = TRUE),
      tn = mean(tn, na.rm = TRUE),
      tx = mean(tx, na.rm = TRUE),
      rr = mean(rr, na.rm = TRUE)
    ),
    by = .(Country, date)
  ][order(Country, date)]
  
  fwrite(
    chunk_out,
    out_file,
    append = file.exists(out_file),
    col.names = !file.exists(out_file)
  )
  
  rm(tg_arr, tn_arr, tx_arr, rr_arr, dt, chunk_out)
  gc()
  
  message("Finished up to: ", max(date_chunk))
}

