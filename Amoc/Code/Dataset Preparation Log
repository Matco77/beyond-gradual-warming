read_window_mean <- function(file, varname, start_layer, end_layer) {
  
  nc <- nc_open(file)
  
  lon_name <- if ("lon" %in% names(nc$dim)) "lon" else "longitude"
  lat_name <- if ("lat" %in% names(nc$dim)) "lat" else "latitude"
  
  lon <- ncvar_get(nc, lon_name)
  lat <- ncvar_get(nc, lat_name)
  
  nlon <- length(lon)
  nlat <- length(lat)
  ntime <- end_layer - start_layer + 1
  
  arr <- ncvar_get(
    nc,
    varname,
    start = c(1, 1, start_layer),
    count = c(nlon, nlat, ntime)
  )
  
  nc_close(nc)
  
  mean_map <- apply(arr, c(1, 2), mean, na.rm = TRUE)
  
  list(
    lon = lon,
    lat = lat,
    mean_map = mean_map
  )
}

monthly_index <- function(start_year, end_year, first_year) {
  start_layer <- (start_year - first_year) * 12 + 1
  end_layer <- (end_year - first_year + 1) * 12
  c(start_layer, end_layer)
}

plot_anomaly_map <- function(lon, lat, z, title_text, output_file) {
  
  png(output_file, width = 1200, height = 800)
  
  image(
    lon,
    lat,
    z,
    main = title_text,
    xlab = "Longitude",
    ylab = "Latitude"
  )
  
  contour(
    lon,
    lat,
    z,
    add = TRUE
  )
  
  dev.off()
}

